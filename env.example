# این فایل فقط نمونه است. مقدارهای واقعی را در پنل Render وارد کن (یا برای تست
# لوکال، این فایل را با اسم .env کپی کن). فایل .env هرگز وارد گیت‌هاب نمی‌شود.

# کلید CodeCraft API (شبیه cc_xxxxxxxx)
CODECRAFT_API_KEY=cc_your_key

# اختیاری: نام مدل (پیش‌فرض: gpt-5.6-luna)
# CODECRAFT_MODEL=gpt-5.6-luna

# توکن ربات تلگرام از BotFather
TELEGRAM_BOT_TOKEN=

# آیدی عددی تلگرام خودت و رمز پنل ادمین (/admin)
ADMIN_TELEGRAM_ID=
ADMIN_PASSWORD=

# اختیاری: متن معرفی صاحب ربات (یا فایل about-me.txt کنار server.js بگذار)
# ABOUT_ME_TEXT=
